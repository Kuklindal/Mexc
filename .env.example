# MEXC P2P merchant API credentials
MEXC_API_KEY=replace_me
MEXC_SECRET_KEY=replace_me
# Two participants for the guided cycle (separate accounts).
MEXC_P1_API_KEY=
MEXC_P1_SECRET_KEY=
# Постоянные объявления П1: продажа для первой сделки, покупка для обратной.
MEXC_P1_SELL_ADV_NO=
MEXC_P1_BUY_ADV_NO=
# Желаемая проверка для прежних планов. 1 = удостоверение личности.
# Не заменяет галочку на MEXC; новый путь пополняет только количество через AdsPower.
MEXC_P1_OVER_VERIFY='{"types":[1]}'
MEXC_P2_API_KEY=
MEXC_P2_SECRET_KEY=
# ID собственных реквизитов П2 (data.id из /api/payment/user), не payMethod=578.
# Необязательно: если заполнено, при обратной продаже ID подставляется автоматически.
MEXC_P2_PAYMENT_ID=
# Необязательно: отдельный прокси для API и чата этого П2 (http:// или socks5://).
# На Linux адрес 127.0.0.1 здесь означает сам Linux-сервер.
MEXC_P2_PROXY_URL=
# Тип оплаты наличными; не заменяет ID реквизитов П2 выше.
MEXC_PAY_METHOD_ID=578
# Авторежим: новая случайная пауза перед каждым действием (секунды, включительно).
ACTION_DELAY_MIN_SECONDS=20
ACTION_DELAY_MAX_SECONDS=30
# Если обе границы отсутствуют, используется старый ACTION_DELAY_SECONDS (по умолчанию 20).
# Следующие границы применяются только к старой команде cycle --auto.
# Режимы Telegram «Все профили»/«Один профиль» их игнорируют и читают объявление П1.
AUTO_MIN_AMOUNT=
AUTO_MAX_AMOUNT=
AUTO_FIAT=RUB
# Три участника недельного распределения в Google Таблице.
WEEKLY_PARTICIPANTS=VERS,Danil,Lenya
# Управление через Telegram: все П2 по порядку либо один выбранный профиль.
# Сумма для этих режимов рассчитывается каждый раз из maxSingleTransAmount/price объявления П1.
ROLLOVER_PROFILES=default,2,3
# Случайный выбор только среди доступных сетей с явно указанным адресом П1.
# BEP20 в API MEXC называется BSC.
ROLLOVER_NETWORKS=PLASMA,BEP20
MEXC_P1_DEPOSIT_ADDRESS_PLASMA=
MEXC_P1_DEPOSIT_MEMO_PLASMA=
MEXC_P1_DEPOSIT_ADDRESS_BEP20=
MEXC_P1_DEPOSIT_MEMO_BEP20=
ROLLOVER_CONFIRM_TIMEOUT_SECONDS=1800
# memberId из деталей проверенных ордеров; не никнейм и не ID AdsPower.
MEXC_P1_MEMBER_ID=
MEXC_P2_MEMBER_ID=
# П2: точное совпадение ID И ника обязательно. Ник П1 можно не задавать (его ID проверяется).
MEXC_P2_NICKNAME=
MEXC_P1_NICKNAME=
# Выбор П2 для нового цикла: --p2-profile имеет приоритет. default = прежние MEXC_P2_*.
MEXC_P2_PROFILE=default
# В MEXC_P2_PROFILE указывается внутренний ключ: default, 2, 3. В таблице и Telegram показывается *_NICKNAME.
# Дополнительные профили: укажите каждый из них в ROLLOVER_PROFILES.
# Все поля относятся к одному аккаунту П2; пустые поля не берутся из default.
MEXC_P2_2_API_KEY=
MEXC_P2_2_SECRET_KEY=
MEXC_P2_2_MEMBER_ID=
MEXC_P2_2_NICKNAME=
MEXC_P2_2_PAYMENT_ID=
MEXC_P2_2_PROXY_URL=
MEXC_P2_3_API_KEY=
MEXC_P2_3_SECRET_KEY=
MEXC_P2_3_MEMBER_ID=
MEXC_P2_3_NICKNAME=
MEXC_P2_3_PAYMENT_ID=
MEXC_P2_3_PROXY_URL=
MEXC_BASE_URL=https://api.mexc.com
MEXC_RECV_WINDOW=30000

# Проверка документов: manual — кнопка на сайте; adspower — после подтверждения в консоли.
SELLER_CHECK_MODE=manual
ADSPOWER_BASE_URL=http://127.0.0.1:50325
ADSPOWER_P1_PROFILE_ID=
ADSPOWER_API_KEY=

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Управление: в личном чате оператором считается владелец TELEGRAM_CHAT_ID.
# Для группы обязательно задайте личный числовой ID оператора; команды остальных игнорируются.
TELEGRAM_CONTROL_USER_ID=

# Google Sheets: first sale USDT quantity, date and time in Krasnoyarsk (UTC+7).
# Share a separate empty tab with the service account as Editor.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Продажи
GOOGLE_SERVICE_ACCOUNT_FILE=

# Durable progress and pending notifications. Keep this file between launches.
CYCLE_DB=data/cycles.sqlite3

# Monitoring
POLL_INTERVAL_SECONDS=5
ORDER_LOOKBACK_HOURS=24
LOG_LEVEL=INFO
LOG_DIR=logs
# Linux/systemd: false sends logs only to journald (configure its retention separately).
LOG_TO_FILE=true
# Для службы Linux: продолжить серию после перезагрузки, только если она работала до остановки.
AUTO_RESUME_ON_BOOT=false

# Safety: keep false unless you intentionally want CLI state-changing commands enabled.
ENABLE_STATE_CHANGES=false
